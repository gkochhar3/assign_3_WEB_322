<div style="max-width: 300px; margin: 100px auto; font-family: sans-serif; padding: 20px; border: 1px solid #ddd; border-radius: 8px; text-align: center;">
    <h2>Wildlife Login</h2>
    


    <form action="/login" method="POST" style="display: flex; flex-direction: column; gap: 10px;">
        <input type="text" name="username" placeholder="Username" required>
        <input type="password" name="password" placeholder="Password" required>
        <button type="submit" style="background: #2c3e50; color: white; padding: 10px; border: none; cursor: pointer;">
            Login
        </button>
    </form>

        {{#if error}}
        <button type="submit" style="background: rgb(15, 113, 120); color: red; padding: 10px; border: none; cursor: pointer;">
            {{error}}
        </button>
    {{/if}}
</div>
